{
  "name": "dukaflow-backend",
  "version": "1.0.0",
  "description": "DukaFlow Backend API powered by NestJS, Better Auth, and Prisma",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:security": "ts-node test/run-phase1-tests.ts",
    "test:rbac": "ts-node test/run-phase2-tests.ts",
    "test:audit": "ts-node test/independent-phase2-audit.ts",
    "test:phase3": "ts-node test/run-phase3-tests.ts",
    "test:concurrency": "ts-node test/run-concurrency-tests.ts",
    "test:vat-timezone": "ts-node test/run-vat-and-timezone-tests.ts",
    "test:final-audit": "ts-node test/run-final-audit-tests.ts",
    "test:phase4": "ts-node test/run-phase4-tests.ts",
    "test:verify": "ts-node test/system-verify.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@prisma/client": "^5.14.0",
    "better-auth": "^1.1.20",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
