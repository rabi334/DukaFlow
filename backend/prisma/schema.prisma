generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// BETTER AUTH & TENANT CORE MODELS
// ==========================================

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  sales         Sale[]    @relation("CashierSales")
  auditLogs     AuditLog[]

  @@map("user")
}

model Session {
  id                   String        @id @default(uuid())
  expiresAt            DateTime      @map("expires_at")
  token                String        @unique
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  ipAddress            String?       @map("ip_address")
  userAgent            String?       @map("user_agent")
  userId               String        @map("user_id")
  activeOrganizationId String?       @map("active_organization_id")

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

// Organization represents a Business Workspace in DukaFlow
model Organization {
  id             String    @id @default(uuid())
  name           String
  slug           String?   @unique
  logo           String?
  currency       String    @default("ETB")
  businessType   String?   @default("Retail") @map("business_type")
  address        String?
  city           String?   @default("Addis Ababa")
  phoneNumber    String?   @map("phone_number")
  tinNumber      String?   @map("tin_number")
  taxRate        Decimal   @default(0.15) @db.Decimal(5, 4) @map("tax_rate")
  taxInclusive   Boolean   @default(true) @map("tax_inclusive")
  receiptHeader  String?   @map("receipt_header")
  receiptFooter  String?   @map("receipt_footer")
  allowNegative  Boolean   @default(false) @map("allow_negative")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  members        Member[]
  invitations    Invitation[]
  branches       Branch[]
  categories     Category[]
  products       Product[]
  suppliers      Supplier[]
  purchases      Purchase[]
  expenses       Expense[]
  sales          Sale[]
  stockMovements InventoryMovement[]
  auditLogs      AuditLog[]

  @@map("organization")
}

model Member {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           String       @default("cashier") // owner, manager, cashier, inventory_staff, admin
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime     @map("expires_at")
  inviterId      String       @map("inviter_id")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

// ==========================================
// DUKAFLOW OPERATIONAL MODELS
// ==========================================

model Branch {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  address        String?
  isMain         Boolean      @default(false) @map("is_main")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventory      Inventory[]

  @@map("branches")
}

model Category {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, name])
  @@map("categories")
}

model Product {
  id                String              @id @default(uuid())
  organizationId    String              @map("organization_id")
  categoryId        String?             @map("category_id")
  name              String
  sku               String
  barcode           String?
  description       String?
  unit              String              @default("pcs")
  costPrice         Decimal             @db.Decimal(12, 2) @map("cost_price")
  sellingPrice      Decimal             @db.Decimal(12, 2) @map("selling_price")
  minStockThreshold Decimal             @default(5) @db.Decimal(12, 3) @map("min_stock_threshold")
  isArchived        Boolean             @default(false) @map("is_archived")
  imageUrl          String?             @map("image_url")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category          Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventory         Inventory?
  movements         InventoryMovement[]
  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, barcode])
  @@index([organizationId, isArchived])
  @@map("products")
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String   @unique @map("product_id")
  branchId       String?  @map("branch_id")
  quantityOnHand Decimal  @default(0) @db.Decimal(12, 3) @map("quantity_on_hand")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@map("inventory")
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  SALE
  SALE_RETURN
  DAMAGE
  LOSS
  COUNT_ADJUSTMENT
}

model InventoryMovement {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  productId      String            @map("product_id")
  actorUserId    String?           @map("actor_user_id")
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 3)
  reason         String?
  referenceId    String?           @map("reference_id")
  createdAt      DateTime          @default(now()) @map("created_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId, productId, createdAt])
  @@map("inventory_movements")
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  TELEBIRR
  CBE_BIRR
  OTHER
}

model Sale {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  cashierUserId  String        @map("cashier_user_id")
  receiptNumber  String        @map("receipt_number")
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2) @map("discount_amount")
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2) @map("tax_amount")
  totalAmount    Decimal       @db.Decimal(12, 2) @map("total_amount")
  status         SaleStatus    @default(COMPLETED)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cashier        User          @relation("CashierSales", fields: [cashierUserId], references: [id], onDelete: Restrict)
  items          SaleItem[]
  payments       Payment[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, createdAt])
  @@map("sales")
}

model SaleItem {
  id                String   @id @default(uuid())
  saleId            String   @map("sale_id")
  productId         String   @map("product_id")
  quantity          Decimal  @db.Decimal(12, 3)
  unitPriceSnapshot Decimal  @db.Decimal(12, 2) @map("unit_price_snapshot")
  costPriceSnapshot Decimal  @db.Decimal(12, 2) @map("cost_price_snapshot")
  discountAmount    Decimal  @default(0) @db.Decimal(12, 2) @map("discount_amount")
  lineTotal         Decimal  @db.Decimal(12, 2) @map("line_total")

  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("sale_items")
}

model Payment {
  id              String        @id @default(uuid())
  saleId          String        @map("sale_id")
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  referenceNumber String?       @map("reference_number")
  createdAt       DateTime      @default(now()) @map("created_at")

  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Supplier {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  contactName    String?      @map("contact_name")
  phoneNumber    String?      @map("phone_number")
  email          String?
  address        String?
  tinNumber      String?      @map("tin_number")
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases      Purchase[]

  @@unique([organizationId, name])
  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Purchase {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  supplierId     String         @map("supplier_id")
  orderNumber    String         @map("order_number")
  status         PurchaseStatus @default(ORDERED)
  totalAmount    Decimal        @db.Decimal(12, 2) @map("total_amount")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items          PurchaseItem[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchaseId  String   @map("purchase_id")
  productId   String   @map("product_id")
  orderedQty  Decimal  @db.Decimal(12, 3) @map("ordered_qty")
  receivedQty Decimal  @default(0) @db.Decimal(12, 3) @map("received_qty")
  unitCost    Decimal  @db.Decimal(12, 2) @map("unit_cost")
  lineTotal   Decimal  @db.Decimal(12, 2) @map("line_total")

  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("purchase_items")
}

model Expense {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  category       String
  amount         Decimal       @db.Decimal(12, 2)
  date           DateTime      @default(now())
  description    String?
  paymentMethod  PaymentMethod @default(CASH) @map("payment_method")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@map("expenses")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?       @map("organization_id")
  actorUserId    String?       @map("actor_user_id")
  action         String
  entity         String
  entityId       String?       @map("entity_id")
  metadata       Json?
  ipAddress      String?       @map("ip_address")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
